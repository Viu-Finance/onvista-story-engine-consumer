# ==============================================================================
# OnVista Story Engine Consumer - Environment Configuration
# ==============================================================================
#
# Copy this file to `.env` and fill in your actual values.
#
# Usage:
#   cp .env.example .env
#   # Edit .env with your OpenAI API key
#   mvn spring-boot:run -Dspring-boot.run.arguments="--demo --isin=DE0007164600"
#
# IMPORTANT: Never commit .env to version control!
# ==============================================================================

# ==============================================================================
# Required Configuration
# ==============================================================================

# OpenAI API Key (REQUIRED)
# - Get your key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...

# ==============================================================================
# Optional: LLM Configuration
# ==============================================================================

# Model name for story clustering
# - Recommended: gpt-5.2 (best quality)
# - Fallback: gpt-4o-2024-11-20
# - Default: gpt-5.2
# OPENAI_MODEL=gpt-5.2

# Temperature for LLM responses (0.0 = deterministic, 1.0 = creative)
# - Recommended: 0.3 for consistent story clustering
# - NOTE: GPT-5 models only support 1.0
# - Range: 0.0 - 1.0
# - Default: 0.3
# OPENAI_TEMPERATURE=0.3

# ==============================================================================
# Optional: Article Fetching
# ==============================================================================

# Maximum articles to fetch per request
# - OnVista supports up to 500 via pagination
# - Recommended: 100+
# - Range: 10-500
# - Default: 50
# MAX_ARTICLES_PER_REQUEST=100

# Maximum characters per article content
# - Longer = more context for LLM, but higher token costs
# - Default: 5000
# ARTICLE_CONTENT_MAX_CHARS=5000

# ==============================================================================
# Optional: Relevance Filtering Configuration
# ==============================================================================

# Enable LLM-based relevance filtering
# - true: Filter articles by relevance before clustering (costs more LLM calls)
# - false: Process all articles (faster, cheaper, but may include irrelevant news)
# - Recommended: true for companies with high article volume
# - Default: true
# RELEVANCE_FILTER_ENABLED=true

# Relevance threshold (0.0 - 1.0)
# - Articles below this score are filtered out
# - Higher = stricter filtering (fewer articles)
# - Lower = looser filtering (more articles)
# - Recommended: 0.2 (balanced filtering)
# - Range: 0.0 - 1.0
# - Default: 0.2
# RELEVANCE_FILTER_THRESHOLD=0.2

# Model for relevance filtering
# - Recommended: gpt-5-mini (cost-effective for simple scoring)
# - Default: gpt-5-mini
# RELEVANCE_FILTER_MODEL=gpt-5-mini

# Temperature for relevance filtering
# - Lower = more consistent scoring
# - Default: 0.1
# RELEVANCE_FILTER_TEMPERATURE=0.1

# Maximum concurrent relevance scoring calls
# - Number of articles scored in parallel
# - Higher = faster, but higher LLM costs
# - Default: 10
# RELEVANCE_FILTER_MAX_CONCURRENT=10

# ==============================================================================
# Optional: Cache Configuration
# ==============================================================================

# Cache backend type
# - memory: In-memory cache (recommended for library usage)
# - redis: Redis cache (requires Redis server)
# - tiered: L1 memory + L2 Redis (best performance, requires Redis)
# - Default: memory
# CACHE_BACKEND=memory

# In-memory cache size
# - Number of entries to keep in memory
# - Default: 1000
# MEMORY_CACHE_MAX_SIZE=1000

# Cache TTL (Time To Live) in seconds
# - Note: Caches use content-hash verification for automatic invalidation
# - TTL is only used for eventual cleanup, NOT for freshness control
# - Default: 31536000 (1 year)
# CACHE_TTL_STORIES=31536000

# ==============================================================================
# Optional: OnVista API Configuration
# ==============================================================================

# OnVista API base URL
# - Production: https://prod-api.onvista.de/api/v1
# - Do not change unless using a proxy or mock server
# - Default: https://prod-api.onvista.de/api/v1
# ONVISTA_BASE_URL=https://prod-api.onvista.de/api/v1

# Maximum concurrent article fetches
# - Higher = faster, but may hit rate limits
# - Lower = slower, but more polite to API
# - Recommended: 20
# - Range: 1-50
# - Default: 20
# ONVISTA_MAX_CONCURRENT=20

# Timeout for OnVista API requests (seconds)
# - Default: 30
# ONVISTA_TIMEOUT=30

# ==============================================================================
# Optional: Logging
# ==============================================================================

# Log level
# - DEBUG: Verbose logging (includes API calls, cache hits/misses)
# - INFO: Standard logging (recommended)
# - WARN: Only warnings and errors
# - Default: INFO
# LOG_LEVEL=INFO

# ==============================================================================
# Example Configurations
# ==============================================================================

# === Minimal Setup (only required field) ===
# OPENAI_API_KEY=sk-...

# === Cost-Optimized Setup ===
# OPENAI_API_KEY=sk-...
# RELEVANCE_FILTER_ENABLED=false
# MAX_ARTICLES_PER_REQUEST=30

# === Quality-Optimized Setup ===
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-5.2
# RELEVANCE_FILTER_ENABLED=true
# RELEVANCE_FILTER_THRESHOLD=0.3
# MAX_ARTICLES_PER_REQUEST=100

# === Development/Testing Setup ===
# OPENAI_API_KEY=sk-...
# LOG_LEVEL=DEBUG
# MAX_ARTICLES_PER_REQUEST=20
# RELEVANCE_FILTER_ENABLED=true

# ==============================================================================
# Notes
# ==============================================================================
#
# 1. Cost Optimization:
#    - Disable relevance filtering (RELEVANCE_FILTER_ENABLED=false)
#    - Reduce max articles (MAX_ARTICLES_PER_REQUEST=30)
#    - Use gpt-5-mini for relevance filtering if enabled
#
# 2. Quality vs Cost Trade-off:
#    - Best quality: gpt-5.2, relevance filtering enabled, threshold 0.3+
#    - Balanced: gpt-5.2, relevance filtering disabled
#    - Budget: gpt-4o-2024-11-20, relevance filtering disabled
#
# 3. Cache Configuration:
#    - For library usage, memory cache is sufficient
#    - For multiple instances, use Redis cache (requires Redis server)
#    - Tiered cache provides best performance with Redis fallback
#
# 4. OnVista API:
#    - Base URL is auto-configured to production API
#    - Only change if using a proxy or local mock server
#    - The library handles pagination and rate limiting automatically
#
# ==============================================================================
